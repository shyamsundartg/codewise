# ---- Option 1: Claude (Anthropic) for answers + local embeddings (no second key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-sonnet-5-5          # or claude-haiku-5-5 for cheaper/faster
# EMBEDDING_PROVIDER=local              # default for anthropic; model downloads once (~70 MB)

# ---- Option 2: OpenAI for both answers and embeddings
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Option 3: fully offline demo (no key, extractive answers)
# LLM_PROVIDER=fake

# Retrieval knobs
TOP_K=8
CONTEXT_TOKEN_BUDGET=6000
